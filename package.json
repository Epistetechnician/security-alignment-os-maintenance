{
  "name": "security-alignment-os-checks",
  "private": true,
  "scripts": {
    "lint:fast": "cargo fmt --all -- --check",
    "test:focused": "cargo test --all-targets",
    "verify:contracts": "cargo clippy --all-targets -- -D warnings",
    "verify:full": "pnpm run lint:fast && pnpm run test:focused && pnpm run verify:contracts",
    "lint": "pnpm run verify:full"
  }
}
